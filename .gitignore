# Claude Code session transcript logs
*.txt
!requirements*.txt
# The wake-word model reads these at runtime.
!aura-android/app/src/main/assets/kws/*.txt
# Golden-file test fixtures. These ARE the assertion — a fixture that is not committed makes
# its test pass locally and fail on a clean checkout with "missing fixture", which reads as a
# broken test rather than as the untracked file it is. (Found 2026-08-26, the hard way.)
!aura-android/**/src/test/resources/golden/*.txt
.video
.coding agent
# graphify generated code-graph output (regenerable; any location)
graphify-out/
.graphify_*

# Local MCP client config — carries a one-time WebRTC pairing PIN; never commit
.mcp.json

# Claude Code local-only session/brainstorm state — never commit
.superpowers/

# Claude Code machine-specific overrides — never commit
.claude/settings.local.json

# Scratch/eval output — never commit
_gtmp/

# On-device logcat dumps. These capture the LIVE session, which means BYOK API
# keys (AIzaSy…) and other apps' log output land in them verbatim, and they run
# to tens of MB. Never commit — a binary/secret blob in history is unfixable
# without a history rewrite.
scratch_live_*.log
*.logcat

# Site build cache
site/scripts/.cache_metadata/

# Firebase CLI local state
.firebase/

# Playwright MCP session artifacts (console logs + page snapshots)
.playwright-mcp/

# Local verification screenshots — some capture console/account UI
fleet-signin*.png
hero-live-check.png

# Personal documents that happen to sit in the repo root — never commit
Dinesh_Kumar_Resume.*

# Extracted reference code, not part of the build
overlay-feature-code/

# AndroidWorld benchmark: upstream clone + its venv, not ours to track
android_world/
androidworld-venv/

# Benchmark output: regenerable, and the videos are large
bench-results/
bench-site/
runs/

