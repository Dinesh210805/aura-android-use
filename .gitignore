# Dependencies and build output
node_modules/
build/
dist/
*.egg-info/
*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Test coverage
.coverage
htmlcov/
coverage/

# Secrets and machine-local config. The *.example files show the expected shape.
.env
.env.*
!.env.example
.mcp.json
aura-android/app/google-services.json
aura-mcp-connect/firebase-config.json
# Release signing keys, anywhere in the tree. Losing one means never being able to update the app
# under the same identity again; leaking one lets anyone ship a forged update. Keep the .jks
# outside the repo and point at it with an absolute path in aura-android/local.properties.
*.jks
*.keystore

# Maintainer-only release tooling: Firebase project config, rules, dashboard and release
# scripts live beside the checkout but are not part of the open-source tree.
firebase.json
.firebaserc
firestore.rules
database.rules.json
dashboard/
release-app.sh
release-site.sh
.firebase/
_private/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tool state
.vercel/
.claude/
.agents/
.superpowers/
.playwright-mcp/
graphify-out/
.graphify_*

# Chat transcript exports land in the repo root. Root only: a repo-wide *.txt would also hide
# assets such as assets/kws/*.txt, which the wake word needs.
/*.txt

# Benchmark and scratch output
bench-results/
bench-site/
runs/
android_world/
androidworld-venv/
_gtmp/

# On-device logcat dumps carry live BYOK API keys and other apps' logs.
*.logcat
