<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and lower. Pairing tokens stay on this device:
     change together with AppTrustedClients and data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="aura_mcp_trust.xml" />
    <!-- API keys: encrypted with a Keystore key that never leaves this phone. -->
    <exclude domain="sharedpref" path="aura_secure_keys.xml" />
    <!-- The agent's run log and screen history hold screen text and screenshots. -->
    <exclude domain="file" path="agentcore/traces/" />
    <exclude domain="file" path="agentcore/screens/" />
</full-backup-content>
